+// Local patch: Q6_K embedding rows (strata/dequant.hpp dequantize_q6_K, same ggml layout). 32 threads
+// cover the 256 values of one super-block: two 128-value halves, each four 32-value groups of 8 scales.
+template<typename dst_t>
+__device__ void dq_q6_k(const void* vx, int64_t ibs, dst_t* yy, int tid) {
+    const block_q6_K* x = (const block_q6_K*) vx + ibs;
+    const float d = (float) x->d;
+    for (int i = tid; i < 256; i += 32) {
+        const int h = i >> 7, r = i & 127, k = r >> 5, l = r & 31, is = l >> 4;
+        const uint8_t* q = x->ql + 64 * h;
+        const uint8_t* qh = x->qh + 32 * h;
+        const int8_t* s = x->scales + 8 * h;
+        int lo, hi, si;
+        if (k == 0)      { lo = q[l] & 0xF;      hi = (qh[l] >> 0) & 3; si = is + 0; }
+        else if (k == 1) { lo = q[l + 32] & 0xF; hi = (qh[l] >> 2) & 3; si = is + 2; }
+        else if (k == 2) { lo = q[l] >> 4;       hi = (qh[l] >> 4) & 3; si = is + 4; }
+        else             { lo = q[l + 32] >> 4;  hi = (qh[l] >> 6) & 3; si = is + 6; }
+        yy[i] = cvt<dst_t>(d * (float) s[si] * (float) ((lo | (hi << 4)) - 32));
+    }
+}
