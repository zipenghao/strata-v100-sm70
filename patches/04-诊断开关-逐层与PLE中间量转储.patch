+/// Allocate the snapshot's pinned host buffer.  Called OUTSIDE graph capture - cudaHostAlloc/cudaFreeHost
+/// synchronize, so doing either inside a capture leaves the capture poisoned.
+static bool layer_stage_ready(int64_t n_layers, int64_t stride) {
+    if (g_lstage != nullptr && g_lcap >= n_layers * stride) return true;
+    if (g_lstage) { cudaFreeHost(g_lstage); g_lstage = nullptr; g_lcap = 0; }
+    if (cudaHostAlloc((void**) &g_lstage, sizeof(float) * (size_t) (n_layers * stride),
+                      cudaHostAllocDefault) != cudaSuccess) { g_lstage = nullptr; g_lcap = 0; return false; }
+    g_lcap = n_layers * stride;
+    return true;
+}
